# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
# 版本越界时脚本会把旧环境重命名成 .venv.bak-<时间戳>，同样不入库
.venv.bak*/
venv/
env/

# ---------- Node / 前端 ----------
node_modules/
frontend/dist/
frontend/.vite/
# vite build 每次会在 frontend/ 根留下 config 时间戳临时文件
vite.config.ts.timestamp-*
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 本地模型权重（GB 级，不入库） ----------
models/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# ---------- 运行时数据（API Key / 生成产物 / 工作流状态 / 导出包） ----------
data/*
!data/.gitkeep
# 画风示例图是静态资产（gen_style_samples.py 生成，约 3MB），随仓库分发，
# 保证新克隆画风 tooltip 开箱即有图；删除此行则需本地跑一次生成脚本
!data/style_samples/
# 人物像素化档位示例图（gen_char_pixel_samples.py 生成），随仓库分发
!data/char_pixel_samples/

# ---------- 冒烟测试与临时产物 ----------
smoke-*.png
.tmp/
tmp/
# 效果对比图（本地留档，不入库）
compare-*.png

# ---------- 环境与密钥 ----------
.env
.env.*
!.env.example
*.key
secrets.json

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- 工作区记忆（本地会话日志，不入库） ----------
.workbuddy/

# 画风 A/B 对照产物（本地验证用，不入库）
backend/out_style_ab/
backend/out_sprite/

# 本地验证用的对照图 / 示意拼图
backend/out_*.png
