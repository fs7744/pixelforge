# 统一换行符：shell 脚本必须 LF，否则 Linux/macOS 上会报 $'\r': command not found
*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.py   text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.ya?ml text eol=lf

# 二进制资源不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.onnx binary
*.safetensors binary
*.ttf  binary
*.woff2 binary
